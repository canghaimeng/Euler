FROM python:3.12-slim
WORKDIR /app
COPY pyproject.toml README.md LICENSE LICENSING.md NOTICE ./
COPY LICENSES ./LICENSES
COPY euler ./euler
RUN pip install --no-cache-dir '.[observability]' \
    && useradd --uid 10001 --create-home euler-viewer
USER euler-viewer
ENV EULER_DASHBOARD_PID_MODE=metadata
EXPOSE 8099
ENTRYPOINT ["euler-dashboard"]
CMD ["--project", "/data/project", "--host", "0.0.0.0", "--port", "8099"]
