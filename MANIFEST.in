include LICENSE LICENSING.md NOTICE CONTRIBUTING.md ARCHITECTURE.md
include README.zh-CN.md ARCHITECTURE.zh.md CONTRIBUTING.zh.md LICENSING.zh.md
include Dockerfile.dashboard .dockerignore
recursive-include docs *.md
recursive-include scripts *.sh *.py *.mjs
recursive-include bin *
recursive-include config *.example *.json
recursive-include agents *.md *.json *.toml *.yaml *.yml *.py *.sh *.js *.css *.tex *.bib *.bst *.cls *.sty
recursive-include examples *.md *.json *.py
recursive-include euler/observability/static *
include euler/observability/proof_guides.json
global-exclude *.py[cod] .DS_Store
prune runtime
prune .venv
prune agents/skills/human-summary/node_modules

recursive-include LICENSES *.txt
recursive-include docs/assets *.svg *.png

# Explicitly selected case papers only.
include examples/nikoghosyan/paper.pdf
include examples/lewis-overton/paper.pdf
include examples/jnw/paper.pdf
