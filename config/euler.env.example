# =============================================================================
# Euler — single host/account configuration source.
#
#   cp config/euler.env.example config/euler.env   # then edit config/euler.env
#
# Everything host- or account-specific lives HERE (and nowhere else in the tree
# — no path is hardcoded in the code or scripts). `scripts/env.sh` sources the
# config chain: config/providers.env -> config/euler.env -> runtime/runtime.env
# (machine paths written by bootstrap.sh) -> hardcoded defaults. The bin/
# wrappers source env.sh for you.
#
# Leave a line commented to accept the default shown next to it.
# This file is gitignored; only *.env.example is committed.
# =============================================================================

# ---- codex backend (workers + verifier spend this) --------------------------
# Default: `api` — your BYO OpenAI-compatible endpoint from config/providers.env
# (see config/providers.env.example). Set `chatgpt` to use YOUR ChatGPT Pro/Plus
# subscription instead, then run `scripts/setup-codex.sh login`.
# CODEX_BACKEND=api
# CODEX_HOME=<repo>/runtime/codex-home                       # auth/config home (gitignored)

# ---- Strategic consults (consult-pro skill) ---------------------------------
# Transport: gpt_pro | claude_api | claude_code | off
#   gpt_pro : paid OpenAI-compatible Responses endpoint (EULER_CONSULT_* below).
#   claude_api: paid Anthropic API, native SDK — per-token billing to YOUR key
#             (EULER_CONSULT_CLAUDE_API_* below). The envelope cost is the
#             response's REAL token usage x the per-1M rates.
#   claude_code: YOUR Claude subscription via the Claude Code CLI (`claude -p`) —
#             no separate API key, but
#             NOT free: it consumes your plan's quota, and usage beyond the plan
#             (or premium models) can be billed extra. Each consult is metered
#             into the spend ledger at the EULER_CONSULT_CLAUDE_CODE_PRICE_* estimate
#             rates below. Needs the `claude` CLI installed + logged in. Do NOT
#             set ANTHROPIC_API_KEY (it silently switches to per-token API billing).
#   off     : disable auto-consult entirely; the main agent does its own reasoning.
EULER_CONSULT_TRANSPORT=gpt_pro

# gpt_pro credentials (needed for transport=gpt_pro). Any OpenAI-compatible
# Responses API. Defaults to OpenAI's official endpoint when BASE_URL is unset;
# point it at Azure OpenAI / your own proxy if you prefer.
# EULER_CONSULT_API_KEY=
# EULER_CONSULT_BASE_URL=https://api.openai.com/v1
# EULER_CONSULT_MODEL=gpt-5.5-pro
# Transport-level Responses params. Defaults suit OpenAI; if a stricter gateway
# 400s on one of them, its error names it — turn that one off here.
# EULER_CONSULT_BACKGROUND=1        # 0 = do not send background=true
# EULER_CONSULT_STORE=0             # 1 = send store=true (some gateways require it)

# transport=claude_code knobs (Claude subscription). Model is also overridable per-call
# with the `--model` flag; tools stay least-privilege (web lookups only, no Bash).
# EULER_CONSULT_CLAUDE_CODE_MODEL=claude-sonnet-4-5   # any Claude model (e.g. claude-opus-4-1)
# EULER_CONSULT_CLAUDE_CODE_BIN=claude             # path to the claude CLI (else PATH)
# EULER_CONSULT_CLAUDE_CODE_MAX_WALL=1800                 # hard wall-clock cap per consult (s)
# EULER_CONSULT_CLAUDE_CODE_PRICE_IN=10.0          # ledger estimate, USD per 1M input tokens
# EULER_CONSULT_CLAUDE_CODE_PRICE_OUT=50.0         # ledger estimate, USD per 1M output tokens

# transport=claude_api knobs (native Anthropic API, per-token). Model overridable
# per-call with `--model`; server-side web search is the only consult tool.
# EULER_CONSULT_CLAUDE_API_KEY=            # falls back to ANTHROPIC_API_KEY
# EULER_CONSULT_CLAUDE_API_BASE_URL=           # only for a proxy; default is Anthropic
# EULER_CONSULT_CLAUDE_API_MODEL=claude-sonnet-4-5 # any Claude model (e.g. claude-opus-4-1)
# EULER_CONSULT_CLAUDE_API_FALLBACK=claude-opus-4-1 # refusal-fallback model; `off` disables
# EULER_CONSULT_CLAUDE_API_PRICE_IN=10.0       # USD per 1M input tokens (real usage)
# EULER_CONSULT_CLAUDE_API_PRICE_OUT=50.0      # USD per 1M output tokens (real usage)

# ---- Models / reasoning effort ----------------------------------------------
# The verifier supports a cold-start `grok`, `codex`, or `cursor` backend. All use the
# same verifier contract and the read-only EULER_ROLE=verifier MCP surface.
# EULER_VERIFY_BACKEND=grok           # grok (default) | cursor/codex rollback
# EULER_GROK_BIN=grok
# EULER_VERIFY_GROK_MODEL=grok-4.6
# EULER_VERIFY_GROK_EFFORT=high
# EULER_GROK_AUTH_FILE=               # default: ~/.grok/auth.json
# EULER_VERIFY_GROK_HOME=              # default: <EULER_ROOT>/runtime/grok-verifier-home
# EULER_DISABLE_CURSOR=1               # forbid legacy Cursor workers/verifier
# EULER_CURSOR_BIN=cursor-agent       # Cursor CLI binary
# EULER_VERIFY_CURSOR_MODEL=cursor-grok-4.6-xhigh
# EULER_CURSOR_AUTH_FILE=              # default: ~/.config/cursor/auth.json
# EULER_VERIFY_CURSOR_HOME=            # default: <VERIFY_AGENT_HOME>/.cursor-home
# Codex-backed sites resolve binary + model + effort through the shared launcher.
# EULER_CODEX_BIN=                   # codex binary (else <repo>/bin/codex, else PATH)
EULER_CODEX_MODEL=gpt-5.5          # neutral default model (all sites)
EULER_CODEX_EFFORT=xhigh           # neutral default reasoning effort (all sites)
# Per-service overrides (fall back to the neutral EULER_CODEX_* above):
# EULER_VERIFY_MODEL / EULER_VERIFY_EFFORT              # codex verifier only
# EULER_WRITE_PAPER_MODEL / EULER_WRITE_PAPER_EFFORT    # paper renderer
# EULER_HUMAN_SUMMARY_MODEL / EULER_HUMAN_SUMMARY_EFFORT # human-summary renderer

# ---- Ports (all loopback) ---------------------------------------------------
VERIFY_PORT=8091                    # verify service HTTP gateway
DASHBOARD_PORT=8099                 # read-only dashboard

# ---- Runtime data locations (all gitignored; default under runtime/) --------
# EULER_RUNTIME=<repo>/runtime
# EULER_AGENTS_ROOT=$EULER_RUNTIME/projects      # where `euler new` puts projects
# VERIFIER_RESULTS_DIR=$EULER_RUNTIME/verify-runs

# ---- Worker loop pacing (optional; engine defaults are sane) ----------------
# EULER_ROUND_HARD_TIMEOUT=14400    # per-round wall clock cap (4h)
# EULER_MAX_ROUNDS=0                 # 0 = unlimited
