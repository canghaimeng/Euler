#!/usr/bin/env bash
# SPDX-License-Identifier: Apache-2.0 AND PolyForm-Noncommercial-1.0.0
# Adapted from Danus/Rethlas; modified for Euler Agent by canghaimeng.
# Upstream portions: Apache-2.0; Euler modifications: PolyForm-Noncommercial-1.0.0.
# human-summary-mcp — launches the human-summary MCP service (role=main) for
# Claude Code (.mcp.json) or any MCP client. Sources env so EULER_AGENTS_ROOT
# etc. are set, and exports EULER_HUMAN_SUMMARY_SKILL_DIR so the assembler finds
# the operator-editable fixed writer prompt (agents/skills/human-summary/REPORT_WRITER_PROMPT.md).
set -euo pipefail
HERE="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
. "$HERE/../scripts/env.sh" >/dev/null 2>&1
export EULER_ROLE="${EULER_ROLE:-main}"
export EULER_AUTHOR="${EULER_AUTHOR:-main_agent}"
export EULER_HUMAN_SUMMARY_SKILL_DIR="${EULER_HUMAN_SUMMARY_SKILL_DIR:-$EULER_ROOT/agents/skills/human-summary}"
exec "$EULER_PY" -m euler.human_summary "$@"
